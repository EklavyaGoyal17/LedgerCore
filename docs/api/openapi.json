{
  "openapi": "3.1.0",
  "info": {
    "title": "LedgerCore \u00e2\u20ac\u201d SIMULATED financial infrastructure",
    "description": "Educational double-entry ledger. No real money or payment rails. Amounts are decimal strings in INR or USD. Monetary POSTs require Idempotency-Key; replay preserves status and JSON values.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8088",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/v1/transfers": {
      "post": {
        "tags": [
          "transfer-controller"
        ],
        "summary": "Atomically transfer simulated funds; replay using the original Idempotency-Key",
        "operationId": "transfer",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Committed simulated movement; idempotent replay returns the same status and JSON values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient funds: durable Problem Details including transferId. Currency or inactive-account validation also uses 422."
          },
          "409": {
            "description": "Idempotency payload conflict or original transfer already reversed"
          },
          "503": {
            "description": "Outcome unconfirmed: retry using the original key"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/transfers/{id}/reversals": {
