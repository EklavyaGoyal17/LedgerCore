  "components": {
    "schemas": {
      "TransferRequest": {
        "type": "object",
        "properties": {
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "example": "500.00",
            "minLength": 1,
            "pattern": "[0-9]{1,11}(\\.[0-9]{1,2})?"
          },
          "currency": {
            "type": "string",
            "pattern": "INR|USD"
          }
        },
        "required": [
          "amount",
          "currency",
          "destinationAccountId",
          "sourceAccountId"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12,
            "pattern": "[\\x20-\\x7E]+"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DepositRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "example": "1000.00",
            "minLength": 1,
            "pattern": "[0-9]{1,11}(\\.[0-9]{1,2})?"
          },
          "currency": {
            "type": "string",
            "pattern": "INR|USD"
          }
        },
        "required": [
          "accountId",
          "amount",
          "currency"
        ]
      },
      "Discrepancy": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordsChecked": {
            "type": "integer",
            "format": "int64"
          },
          "discrepancies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Discrepancy"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateAccount": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "INR|USD"
          }
        },
        "required": [
          "currency"
        ]
      },
      "View": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Transfer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "failureCode": {
            "type": "string"
          },
          "journalId": {
            "type": "string",
            "format": "uuid"
          },
          "originalTransferId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
